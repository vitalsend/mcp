  },
  "license": "AGPL-3.0-or-later",
  "author": "Jörgen Karlsson <jorgen@karlsson.com> (https://vitalsend.eu)",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitalsend/mcp"
  },
  "scripts": {
    "sync-vendor": "node sync-vendor.mjs",
