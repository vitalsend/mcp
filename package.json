  "bin": {
    "vitalsend-mcp": "dist/vitalsend-mcp.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "npm-shrinkwrap.json",
    "server.json"
  ],
  "engines": {
